{
  "name": "levelhead",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "benchmarks"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "trustedDependencies": [],
  "scripts": {
    "data:backup": "bun run scripts/backup.ts",
    "data:restore": "bun run scripts/restore.ts",
    "data:pg:backup": "bun run scripts/postgres-backup.ts backup",
    "data:pg:restore": "bun run scripts/postgres-backup.ts restore",
    "runtime:budget": "bun run scripts/runtime-budget.ts",
    "models:preflight": "bun run benchmarks/src/local-models/cli.ts",
    "models:asr:run": "bun run benchmarks/src/local-models/asr-cli.ts",
    "feedback:check": "bun run scripts/check-feedback.ts",
    "review:packet": "bun run scripts/review-packet.ts",
    "review:validate": "bun run scripts/review-records.ts",
    "dev": "bun run --filter '*' dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run contracts:check",
    "test": "bun test",
    "contracts:generate": "bun run scripts/generate-contracts.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f db",
    "llama:up": "docker compose -f infra/docker-compose.yml --profile models up -d llama",
    "llama:up:gpu": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.gpu.yml --profile models up -d llama",
    "llama:down": "docker compose -f infra/docker-compose.yml --profile models down",
    "llama:logs": "docker compose -f infra/docker-compose.yml logs -f llama",
    "levelhead": "bun run apps/cli/src/index.ts",
    "fixtures:build": "bun run scripts/build-fixtures.ts",
    "db:migrate": "bun run packages/db/src/migrate-cli.ts",
    "fixtures:benchmark": "bun run scripts/build-benchmark-fixtures.ts",
    "voice:up": "uv run voice/serve.py",
    "voice:stream": "uv run voice/stream_server.py",
    "contracts:check": "bun run scripts/generate-contracts.ts --check",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "worker": "bun run apps/worker/src/index.ts",
    "serve": "bun run apps/server/src/index.ts",
    "showcase:up": "bash scripts/showcase.sh up",
    "showcase:down": "bash scripts/showcase.sh down",
    "showcase:url": "bash scripts/showcase.sh url",
    "docker:build": "docker build -f infra/Dockerfile --target runtime -t levelhead-server:local .",
    "mcp": "bun run apps/mcp/src/index.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "smoke": "bun run scripts/smoke.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@levelhead/contracts": "workspace:*",
    "@levelhead/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.0",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
