# --- Documents: private, kept out of git during development ---
# Planning, strategy, and decision records under /docs/ stay private.
# Only the repository-search technical reference is public; nested archives stay ignored.
/docs/*
!/docs/RETRIEVAL.md

# Contributor/agent rules stay out of git too. Kept at the repository root rather than
# under /docs/, because agent tooling reads AGENTS.md from the root by convention.
/AGENTS.md

# --- Dependencies and build output ---
node_modules/
dist/
*.tsbuildinfo

# --- Browser end-to-end artifacts (traces are kept only for a failure, locally) ---
test-results/
playwright-report/
# bun.lock IS committed and installed --frozen-lockfile (bunfig.toml): a drifting
# dependency tree is not reproducible, and reproducibility is the product claim.
# It is deliberately NOT ignored.

# --- Environment (config validated at boot, ADR-022) ---
.env
.env.*
!.env.example

# --- Local artifacts and snapshots (content-addressed object store, ADR-017 / STACK §11) ---
/var/
/.artifacts/

# --- Python research (offline only, under research/, ADR-019) ---
research/.venv/
__pycache__/

# Local self-use loop state: append-only event log, private fixtures.
.levelhead/
fixtures/private/

# Runtime session state written under an app directory. `.closer/` is the pre-rename directory
# name; both are local only and never reviewed, so neither belongs in history.
.closer/
.levelhead/

# Editor and agent-local files: local machine config, not a shared decision.
.claude/
.vscode/
