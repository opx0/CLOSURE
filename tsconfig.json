{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "benchmarks/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/*.gen.ts"]
}
