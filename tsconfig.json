{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/mcp/src/**/*.ts",
    "benchmarks/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/*.gen.ts"]
}
