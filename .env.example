# Copy to .env and fill in. Parsed and validated once at boot; the process exits with a
# readable message if anything here is missing or malformed.

# --- Required for the server and the worker (the CLI defaults to a file-backed log) ---
DATABASE_URL=postgres://closer:closer@localhost:5432/closer

# --- Optional, with defaults ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Where the event log lives. `jsonl` needs no running container. ---
CLOSER_STORE=jsonl
CLOSER_EVENT_DIR=.closer/events
CLOSER_EXPORT_DIR=.closer/exports

# --- Ownership (ADR-023). Auth is deferred; its boundary is not. With no tokens set the server
#     is single-owner and local. Set `owner:token` or `owner:role:token` pairs, comma-separated,
#     to let friends use it; an unrecognised token is nobody, never a fallback to the local owner.
CLOSER_OWNER=local
# CLOSER_API_TOKENS=abhisek:candidate:change-me,friend:candidate:change-me-too

# --- HTTP hardening ---
CLOSER_CORS_ORIGIN=
CLOSER_RATE_LIMIT_PER_MINUTE=120
CLOSER_MAX_BODY_BYTES=262144
# A showcase instance runs on the synthetic résumé and mints a throwaway owner per visitor.
CLOSER_DEMO_MODE=false
CLOSER_WEB_DIST=apps/web/dist

# --- Model provider (required only once interviews run) ---
# MODEL_PROVIDER_API_KEY=
MODEL_ID=claude-opus-5

# --- Voice UI: local speech, both models offline (voice/serve.py). ---
#     Start with `bun run voice:up`; models download once into VOICE_DATA_DIR.
#     Voice is an I/O layer only: pace, pauses and filler words are recorded beside the
#     interview and never enter a finding, the rubric, or the gap ledger.
VOICE_PORT=8091
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium

# --- Local model: llama.cpp + Qwen, the Conductor's offline adapter (ADR-011). ---
#     Optional. Start with `bun run llama:up` (or `llama:up:gpu`); serves an
#     OpenAI-compatible API. Model is downloaded once and cached in a volume.
LLAMA_HF_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
LLAMA_PORT=8081
LLAMA_CONTEXT=8192
LLAMA_BASE_URL=http://localhost:8081/v1

# --- The benchmark's headless-agent arm (PROJECT.md §6.1). Absent means that arm publishes a
#     failure rather than numbers produced by a different model.
# CLOSER_HEADLESS_AGENT_URL=http://localhost:8082/v1

# --- Worker ---
WORKER_NAME=worker-1
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_BATCH=1
WORKER_METRICS_PORT=0

# --- Repository ingestion limits (STACK §18). Breaching one is a named failure, never a
#     truncated snapshot. Repository code is parsed, never executed.
INGEST_MAX_FILES=2000
INGEST_MAX_TOTAL_BYTES=20971520
INGEST_MAX_FILE_BYTES=524288
INGEST_MAX_DEPTH=12
INGEST_TIMEOUT_MS=60000
INGEST_HEAP_MB=1024

# --- Snapshot retention. Deletion keeps the citation and drops the bytes; a later replay reads
#     those citations as `snapshot_deleted`, which is neither resolved nor broken.
SNAPSHOT_RETENTION_DAYS=90

# --- Enforcement ceilings. Breaching one is a named failure,
#     never a truncated context or a partial evaluation. ---
SESSION_TOKEN_CEILING=120000
SESSION_COST_CEILING_USD=2.00
MODEL_CALLS_PER_TURN_CEILING=3

# --- Observability. Logs carry opaque ids only; candidate content never appears in them. ---
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
